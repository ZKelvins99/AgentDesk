{
  "name": "agentdesk",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "可插拔多 Agent 桌面平台（vendor 完整拷贝策略）",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test tests/contracts/*.test.ts",
    "check:isolation": "node scripts/check-platform-isolation.ts",
    "index": "codegraph index ."
  },
  "build": {
    "appId": "com.agentdesk.desktop",
    "productName": "AgentDesk",
    "files": [
      "packages/**/dist/**",
      "packages/platform-panel/public/**"
    ],
    "win": {
      "target": ["nsis", "portable"]
    },
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": ["AppImage", "deb"]
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
