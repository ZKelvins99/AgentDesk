{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["PI_DOWNLOAD_MIRROR"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["out/**", "dist/**"]
    },
    "dist": {
      "dependsOn": ["^build", "build"],
      "outputs": ["release/**"]
    }
  }
}
